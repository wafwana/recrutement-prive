generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDAT
  ENTREPRISE
  CONSULTANT
  ADMIN
  OWNER
}

enum EntityStatus {
  ACTIVE
  EXCLUDED
  ARCHIVED
  SUSPENDED
}

enum DocumentArchiveStatus {
  A_VERIFIER
  VERIFIE
  RECLASSE
  ANOMALIE
}

enum PayoutStatus {
  PENDING
  AUTHORIZED
  REJECTED
}

enum CompanyMemberRole {
  OWNER
  RECRUITER
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

enum SourcingStatus {
  DETECTED
  REVIEWING
  MATCHED
  VALIDATED
  CONTACTED
  REJECTED
}

enum MissionPresentationState {
  MISSION_ACTIVE
  CANDIDAT_ANONYME
  CONDITION_FINANCIERE_EN_ATTENTE
  PAIEMENT_OU_CONDITION_CONFIRME
  IDENTITE_DEBLOQUEE
  MISSION_TERMINEE
}

enum FinancialConditionStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  passwordHash String?
  role Role @default(CANDIDAT)
  status EntityStatus @default(ACTIVE)
  candidat CandidateProfile?
  applications Application[]
  companyLinks CompanyMember[]
  auditEntries RecruitmentHistory[]
  activitySessions CollaboratorActivitySession[]
  conversations ConversationParticipant[]
  sentMessages Message[]
  sourcedCandidates SourcedCandidate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CandidateProfile {
  id String @id @default(cuid())
  userId String @unique
  headline String?
  bio String?
  location String?
  country String?
  phonePrefix String?
  phone String?
  cvUrl String?
  photoMimeType String?
  photoData Bytes?
  skills Json?
  experienceYears Int?
  preferences Json?
  status EntityStatus @default(ACTIVE)
  primaryCategoryId String?
  subCategoryIds    Json?
  primaryCategory   JobCategory? @relation("CandidatePrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  documents CandidateDocument[]
  cvIntakes CvIntake[]
  presentations MissionPresentation[]
  recruitmentInvoices RecruitmentInvoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryCategoryId])
}

model CandidateDocument {
  id String @id @default(cuid())
  candidateId String
  name String
  url String?
  fileData Bytes?
  type String?
  docType String @default("AUTRE")
  folderPath String @default("CANDIDATS/A_CLASSER")
  analysis Json?
  analyzedAt DateTime?
  isPrimaryCv Boolean @default(false)
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([candidateId, docType])
  @@index([folderPath])
}


model CvIntake {
  id                String          @id @default(cuid())
  name              String
  originalName      String
  mimeType          String
  fileData          Bytes
  size              Int
  originalSha256    String
  senderUserId      String
  senderRole        String
  senderEmail       String
  candidateName     String?
  candidateEmail    String?
  docType           String          @default("CV")
  folderPath        String          @default("CANDIDATS/A_CLASSER/CV")
  analysis          Json?
  matching          Json?
  analyzedAt        DateTime?
  status            String          @default("A_ANALYSER")
  candidateId       String?
  candidate         CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([folderPath])
  @@index([candidateId])
  @@index([status, createdAt])
  @@index([originalSha256])
}

model Company {
  id String @id @default(cuid())
  name String
  description String?
  website String?
  country String?
  phonePrefix String?
  phone String?
  logoMimeType String?
  logoData Bytes?
  status EntityStatus @default(ACTIVE)
  members CompanyMember[]
  jobs Job[]
  enterpriseSourcedOffers EnterpriseSourcedOffer[]
  presentations MissionPresentation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyMember {
  id String @id @default(cuid())
  companyId String
  userId String
  role CompanyMemberRole @default(RECRUITER)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([companyId, userId])
  @@index([userId])
}

model Job {
  id String @id @default(cuid())
  companyId String
  title String
  location String?
  description String?
  requiredSkills Json?
  requiredExperienceYears Int?
  attachmentName String?
  attachmentMimeType String?
  attachmentData Bytes?
  status JobStatus @default(DRAFT)
  missionType String?
  financialCondition Json?
  financialConditionStatus FinancialConditionStatus @default(PENDING)
  jobCategoryId String?
  subCategoryId String?
  jobCategory JobCategory? @relation("JobCategoryJobs", fields: [jobCategoryId], references: [id], onDelete: SetNull)
  subCategory JobCategory? @relation("SubCategoryJobs", fields: [subCategoryId], references: [id], onDelete: SetNull)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  presentations MissionPresentation[]
  history RecruitmentHistory[]
  recruitmentBillingRules RecruitmentBillingRule[]
  recruitmentInvoices RecruitmentInvoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, status])
  @@index([jobCategoryId])
  @@index([subCategoryId])
}

model Application {
  id String @id @default(cuid())
  candidateId String
  userId String
  jobId String
  status ApplicationStatus @default(SUBMITTED)
  notes String?
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  history RecruitmentHistory[]
  presentations MissionPresentation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([candidateId, jobId])
  @@index([jobId, status])
}

model MissionPresentation {
  id String @id @default(cuid())
  missionId String
  applicationId String
  candidateId String
  companyId String
  state MissionPresentationState @default(MISSION_ACTIVE)
  financialConditionStatus FinancialConditionStatus @default(PENDING)
  presentedAt DateTime @default(now())
  conditionConfirmedAt DateTime?
  unlockedAt DateTime?
  completedAt DateTime?
  securityDetails Json?
  mission Job @relation(fields: [missionId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([applicationId, companyId])
  @@index([missionId, companyId, state])
  @@index([candidateId, companyId])
}

model EnterpriseSourcedOffer {
  id String @id @default(cuid())
  companyId String
  externalJobId String
  selectedCountry String
  status String @default("QUALIFIED")
  analysis Json?
  matching Json?
  analyzedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalJob ExternalJobOpportunity @relation(fields: [externalJobId], references: [id], onDelete: Cascade)

  @@unique([companyId, externalJobId])
  @@index([companyId, status])
  @@index([selectedCountry])
}

model ExternalJobOpportunity {
  id String @id @default(cuid())
  externalId String
  source String
  sourceUrl String?
  title String
  companyName String?
  country String?
  city String?
  categoryCode String?
  subCategoryCode String?
  skills Json?
  experienceYears Int?
  language String?
  salary String?
  publishedAt DateTime?
  closingAt DateTime?
  description String?
  rawData Json?
  enterpriseMatches EnterpriseSourcedOffer[]
  status String @default("DETECTED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId], map: "external_job_source_external_id_key")
  @@index([status, createdAt])
  @@index([source])
}

model SourcedCandidate {
  id String @id @default(cuid())
  externalId String?
  source String
  sourceProfileUrl String?
  name String?
  headline String?
  location String?
  skills Json?
  experienceYears Int?
  consentStatus String @default("PENDING")
  status SourcingStatus @default(DETECTED)
  matchingScore Int?
  matchingDetails Json?
  notes String?
  createdByUserId String
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([source])
  @@unique([source, externalId], map: "sourced_candidate_source_external_id_key")
}

model RecruitmentHistory {
  id String @id @default(cuid())
  applicationId String?
  jobId String?
  actorUserId String
  action String
  fromStatus String?
  toStatus String?
  details Json?
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
  @@index([jobId, createdAt])
}

model Conversation {
  id String @id @default(cuid())
  subject String @default("Nouvelle conversation")
  participants ConversationParticipant[]
  messages Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ConversationParticipant {
  id String @id @default(cuid())
  conversationId String
  userId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([conversationId, userId])
  @@index([userId])
}
model Message {
  id String @id @default(cuid())
  conversationId String
  senderId String
  body String
  readAt DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}
model SystemSetting {
  id String @id @default(cuid())
  key String @unique
  value Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model JobCategory {
  id                       String             @id @default(cuid())
  code                     String             @unique
  name                     Json
  description              Json?
  parentId                 String?
  parent                   JobCategory?       @relation("JobCategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children                 JobCategory[]      @relation("JobCategoryHierarchy")
  jobs                     Job[]              @relation("JobCategoryJobs")
  subCategoryJobs          Job[]              @relation("SubCategoryJobs")
  primaryCandidateProfiles CandidateProfile[] @relation("CandidatePrimaryCategory")
  sortOrder                Int                @default(0)
  isActive                 Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([parentId])
}

model ArchivedDocument {
  id                 String                @id @default(cuid())
  name               String
  originalName       String?
  mimeType           String?
  fileData           Bytes?
  size               Int?
  senderUserId       String
  senderRole         String
  senderEmail        String
  categoryPath       String
  status             DocumentArchiveStatus @default(A_VERIFIER)
  docType            String?
  companyId          String?
  candidateId        String?
  jobId              String?
  amountHt           Float?
  amountTva          Float?
  amountTtc          Float?
  year               Int?
  month              Int?
  quarter            Int?
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedByUserId   String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([categoryPath])
  @@index([senderUserId])
  @@index([companyId])
  @@index([candidateId])
  @@index([year, month])
  @@index([year, quarter])
}

model OwnerNotification {
  id               String   @id @default(cuid())
  title            String
  message          String
  documentId       String?
  senderName       String?
  senderRole       String?
  status           String   @default("UNREAD")
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actorRole   String
  action      String
  targetType  String?
  targetId    String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}


model CollaboratorActivitySession {
  id            String   @id @default(cuid())
  userId        String
  role          String
  sessionKey    String   @unique
  startedAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  endedAt       DateTime?
  lastPath      String?
  ipAddress     String?
  country       String?
  region        String?
  city          String?
  userAgent     String?
  activeSeconds Int      @default(0)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@index([role, lastSeenAt])
  @@index([startedAt])
}

model AccountingPeriod {
  id             String   @id @default(cuid())
  year           Int
  month          Int?
  quarter        Int?
  periodType     String
  isLocked       Boolean  @default(false)
  lockedAt       DateTime?
  lockedByUserId String?
  summaryData    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([year, month, periodType])
  @@index([year, quarter, periodType])
}

model FinancialPayoutRequest {
  id               String       @id @default(cuid())
  idempotencyKey   String       @unique
  beneficiaryName  String
  beneficiaryEmail String
  beneficiaryIban  String?
  reason           String
  jobId            String?
  invoiceRef       String?
  amountHt         Float
  amountTva        Float        @default(0)
  amountTtc        Float
  fees             Float        @default(0)
  currency         String       @default("EUR")
  status           PayoutStatus @default(PENDING)
  decisionAt       DateTime?
  decisionByUserId String?
  decisionNotes    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([beneficiaryEmail])
}


model RecruitmentBillingRule {
  id             String   @id @default(cuid())
  jobId          String
  billingType    String   @default("PERCENTAGE_SALARY")
  fixedAmountHt  Float?
  percentage     Float?
  vatRate        Float    @default(20)
  currency       String   @default("EUR")
  paymentTerms   Json?
  active         Boolean  @default(true)
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  invoices       RecruitmentInvoice[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([jobId, active])
}

model RecruitmentInvoice {
  id                String   @id @default(cuid())
  invoiceNumber     String   @unique
  companyId         String
  jobId             String?
  presentationId    String?
  billingRuleId     String?
  description       String
  status            String   @default("DRAFT")
  amountHt          Float
  vatRate           Float    @default(20)
  amountTva         Float
  amountTtc         Float
  currency          String   @default("EUR")
  issuedAt          DateTime?
  dueAt             DateTime?
  paidAt            DateTime?
  notes             String?
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  job               Job?     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  presentation      MissionPresentation? @relation(fields: [presentationId], references: [id], onDelete: Restrict)
  billingRule       RecruitmentBillingRule? @relation(fields: [billingRuleId], references: [id], onDelete: SetNull)
  payments          RecruitmentInvoicePayment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([companyId, status])
  @@index([jobId, status])
  @@index([presentationId])
  @@index([dueAt, status])
}

model RecruitmentInvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  amount      Float
  paidAt      DateTime @default(now())
  method      String
  reference   String?
  notes       String?
  invoice     RecruitmentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@index([invoiceId, paidAt])
}
