generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDAT
  ENTREPRISE
  CONSULTANT
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role     @default(CANDIDAT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
